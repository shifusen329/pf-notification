<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the plugin's pure logic. The files below are compiled in as source rather than via a project reference,
    which would drag in Dalamud.NET.Sdk and the game assemblies. Keep linked files free of Dalamud types.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\PfNotification\Detection\FillDetector.cs" Link="Linked\FillDetector.cs" />
    <Compile Include="..\..\PfNotification\Detection\MemberTracker.cs" Link="Linked\MemberTracker.cs" />
    <Compile Include="..\..\PfNotification\Party\AlertText.cs" Link="Linked\AlertText.cs" />
    <Compile Include="..\..\PfNotification\Ntfy\NtfyClient.cs" Link="Linked\NtfyClient.cs" />
    <Compile Include="..\..\PfNotification\Party\RoleCounts.cs" Link="Linked\RoleCounts.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
