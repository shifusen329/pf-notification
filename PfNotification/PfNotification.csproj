<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>shifusen329</Author>
    <Name>PF Notification</Name>
    <Punchline>Phone alerts when your Party Finder party fills, members join or leave, or a duty pops. Optional remote party chat from your phone.</Punchline>
    <Description>Watches your party and sends a notification to your phone through a self-hosted ntfy server when it reaches full size, when members join or leave, and when a Duty Finder queue or roulette pops, so you can step away while recruiting or queueing.
Passive by default: it only observes your own client and never sends anything to the game servers. The one exception is remote party chat, off by default, which posts messages you publish from your phone to party chat on your behalf.
Needs an ntfy topic and access token; set them with /pfnotify. Alpha, for FC members; not intended for the official repository.</Description>
    <RepoUrl>https://github.com/shifusen329/pf-notification</RepoUrl>
    <Tags>party;partyfinder;notification;dutyfinder;chat</Tags>
  </PropertyGroup>
</Project>
